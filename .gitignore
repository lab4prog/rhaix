/target
**/*.rs.bk
*.pdb

# база демо
examples/demo/data/
examples/cookbook/data/

# ключ підпису сесій, який rhaix dev створює сам
.rhaix-secret
**/.rhaix-secret

# cookie-файли curl із ручних перевірок (`curl -c jar.txt`): у них підписані
# сесії, у репозиторії їм не місце
/jc.txt
/jm.txt
*.cookies

# внутрішні нотатки розробки — дорожня карта, оцінка ризиків, журнал знахідок
# по кожній віхі. Корисні під час роботи над фреймворком, стороннім не
# потрібні: залишаються локально, у публічний репозиторій не йдуть.
/PLAN.md
/RISKS.md
/M[0-9]*-FINDINGS.md
