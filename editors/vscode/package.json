{
  "name": "rhaix",
  "displayName": "rhaix (.rhx)",
  "description": "Підсвітка синтаксису для файлів .rhx фреймворку rhaix",
  "version": "0.0.1",
  "publisher": "rhaix",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lab4prog/rhaix"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rhx",
        "aliases": [
          "rhaix",
          "rhx"
        ],
        "extensions": [
          ".rhx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rhx",
        "scopeName": "text.html.rhx",
        "path": "./syntaxes/rhx.tmLanguage.json",
        "embeddedLanguages": {
          "source.rhai": "rhai",
          "meta.embedded.block.html": "html"
        }
      }
    ]
  }
}
