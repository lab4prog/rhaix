{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "rhaix",
  "scopeName": "text.html.rhx",
  "patterns": [
    {
      "include": "#frontmatter"
    },
    {
      "include": "#rhaix-raw"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#special-tag"
    },
    {
      "include": "#component-tag"
    },
    {
      "include": "#html-tag"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "frontmatter": {
      "name": "meta.embedded.block.rhai.rhx",
      "begin": "\\A---\\s*$",
      "end": "^---\\s*$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.frontmatter.begin.rhx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.frontmatter.end.rhx"
        }
      },
      "patterns": [
        {
          "include": "#rhai"
        }
      ]
    },
    "rhai": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rhx",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rhx",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "string.quoted.other.template.rhx",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "meta.embedded.expression.rhx",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.rhx"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.rhx"
                }
              },
              "patterns": [
                {
                  "include": "#rhai"
                }
              ]
            },
            {
              "name": "constant.character.escape.rhx",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.rhx",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rhx",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.rhx",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.rhx",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.numeric.rhx",
          "match": "\\b\\d[\\d_]*(\\.\\d+)?\\b"
        },
        {
          "name": "keyword.control.rhx",
          "match": "\\b(let|const|if|else|for|in|while|loop|do|until|break|continue|return|throw|try|catch|switch|fn|private|import|export|as|global)\\b"
        },
        {
          "name": "constant.language.rhx",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.rhaix.rhx",
          "match": "\\b(req|res|hx|db|session|csrf|http|mail|state|page|log|props|slots|iter)\\b"
        },
        {
          "name": "support.function.rhaix.rhx",
          "match": "\\b(t|locale|set_locale|validate|paginate|url|now|now_ms|today|date|datetime|timestamp|days|hours|minutes|money|percent|slug|cut|strip_tags|capitalize|is_blank|bool|uuid|random_id|sha256|hash_password|verify_password|json|json_encode|json_decode|raw|markdown)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.rhx",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\()"
        },
        {
          "name": "punctuation.definition.map.rhx",
          "match": "#\\{"
        },
        {
          "name": "keyword.operator.rhx",
          "match": "\\?\\?|\\|\\||&&|==|!=|<=|>=|=>|\\+=|-=|\\*=|/=|[-+*/%<>=!?:]"
        }
      ]
    },
    "comment": {
      "name": "comment.block.rhx",
      "begin": "\\{\\{!",
      "end": "\\}\\}"
    },
    "interpolation": {
      "name": "meta.embedded.expression.rhx",
      "begin": "\\{\\{-?",
      "end": "-?\\}\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.rhx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.rhx"
        }
      },
      "patterns": [
        {
          "include": "#rhai"
        }
      ]
    },
    "special-tag": {
      "name": "meta.tag.rhaix.rhx",
      "begin": "(</?)(rhaix:[a-z]+)",
      "end": "(/?>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.rhx"
        },
        "2": {
          "name": "entity.name.tag.rhaix.rhx"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.rhx"
        }
      },
      "patterns": [
        {
          "include": "#tag-guts"
        }
      ]
    },
    "component-tag": {
      "name": "meta.tag.component.rhx",
      "begin": "(</?)([A-Z][A-Za-z0-9]*(?:\\.[A-Za-z0-9]+)*)",
      "end": "(/?>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.rhx"
        },
        "2": {
          "name": "entity.name.tag.component.rhx"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.rhx"
        }
      },
      "patterns": [
        {
          "include": "#tag-guts"
        }
      ]
    },
    "html-tag": {
      "name": "meta.tag.rhx",
      "begin": "(</?)([a-zA-Z][a-zA-Z0-9-]*)",
      "end": "(/?>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.rhx"
        },
        "2": {
          "name": "entity.name.tag.rhx"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.rhx"
        }
      },
      "patterns": [
        {
          "include": "#tag-guts"
        }
      ]
    },
    "tag-guts": {
      "patterns": [
        {
          "include": "#directive"
        },
        {
          "include": "#spread"
        },
        {
          "include": "#attr-expression"
        },
        {
          "include": "#attr-string"
        },
        {
          "include": "#attr-name"
        }
      ]
    },
    "directive": {
      "begin": "(@(if|else-if|else|for|key|class|style|attr|html|text|oob))(?:(=)(\\{))?",
      "end": "(?<=\\})|(?<=[\\s>])|$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.directive.rhx"
        },
        "3": {
          "name": "punctuation.separator.key-value.rhx"
        },
        "4": {
          "name": "punctuation.section.embedded.begin.rhx"
        }
      },
      "patterns": [
        {
          "include": "#rhai"
        },
        {
          "name": "punctuation.section.embedded.end.rhx",
          "match": "\\}"
        }
      ]
    },
    "spread": {
      "name": "meta.embedded.expression.rhx",
      "begin": "\\{\\s*\\.\\.\\.",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.spread.rhx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.rhx"
        }
      },
      "patterns": [
        {
          "include": "#rhai"
        }
      ]
    },
    "attr-expression": {
      "begin": "([a-zA-Z_:][a-zA-Z0-9_.:-]*)(=)(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.rhx"
        },
        "2": {
          "name": "punctuation.separator.key-value.rhx"
        },
        "3": {
          "name": "punctuation.section.embedded.begin.rhx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.rhx"
        }
      },
      "patterns": [
        {
          "include": "#rhai"
        }
      ]
    },
    "attr-string": {
      "begin": "([a-zA-Z_:][a-zA-Z0-9_.:-]*)(=)(\")",
      "end": "\"",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.rhx"
        },
        "2": {
          "name": "punctuation.separator.key-value.rhx"
        },
        "3": {
          "name": "punctuation.definition.string.begin.rhx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.rhx"
        }
      },
      "contentName": "string.quoted.double.rhx",
      "patterns": [
        {
          "include": "#interpolation"
        }
      ]
    },
    "attr-name": {
      "name": "entity.other.attribute-name.rhx",
      "match": "\\b[a-zA-Z_:][a-zA-Z0-9_.:-]*\\b"
    },
    "rhaix-raw": {
      "name": "meta.embedded.block.raw.rhx",
      "begin": "(<)(rhaix:raw)(>)",
      "end": "(</)(rhaix:raw)(>)",
      "beginCaptures": {
        "2": {
          "name": "entity.name.tag.rhaix.rhx"
        }
      },
      "endCaptures": {
        "2": {
          "name": "entity.name.tag.rhaix.rhx"
        }
      },
      "contentName": "string.unquoted.raw.rhx"
    }
  }
}
