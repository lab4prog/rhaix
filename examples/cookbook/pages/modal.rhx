---
// ЗАДАЧА: відкрити картку замовлення в діалозі, не покидаючи сторінку.
// Уся хитрість — порожній контейнер, у який приїжджає фрагмент.
page.title = "Модальне вікно";

let orders = db.find("orders", #{}, #{ sort: "id asc" });
---
<div @if={req.is_htmx} @oob={"#nav"}><Nav /></div>

<h1>Модальне вікно</h1>
<p>Картка живе в <code>partials/OrderCard.rhx</code> і приїжджає в
   <code>#dialog</code>. Закриття — та сама адреса з порожньою відповіддю.</p>

<ul>
  <li @for={o in orders}>
    {{ o.customer }} —
    <a href="#" hx-get={url("/components/ordercard", #{ id: o.id })} hx-target="#dialog">
      показати картку
    </a>
  </li>
</ul>

{{! Порожній контейнер: поки в нього нічого не приїхало, він нічого не важить }}
<div id="dialog"></div>
