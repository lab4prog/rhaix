---
// ЗАДАЧА: прийняти форму, показати помилки поруч із полями, зберегти в базу.
// Валідація — одним викликом `validate()`, а не десятком `if` руками.
// Токен CSRF фреймворк додасть сам — про нього тут немає жодного рядка.
page.title = "Форма з валідацією";

let form   = #{ customer: "", email: "", amount: "" };
let errors = #{};
let saved  = ();

if req.method == "POST" {
    form = req.all_form();
    errors = validate(form, #{
        customer: "required|min:2",
        email:    "required|email",
        amount:   "required|number|min:0.01",
    });

    if errors.is_empty() {
        let id = db.insert("orders", #{
            customer: form.customer.trim(),
            email:    form.email.trim(),
            amount:   req.form_float("amount"),
            status:   "new",
        });
        saved = db.get("orders", id);
        form = #{ customer: "", email: "", amount: "" };
        hx.toast("Замовлення створено", "success");
    } else {
        // 422 — сторінка та сама, але з підсвіченими полями.
        res.status(422);
    }
}
---
<div @if={req.is_htmx} @oob={"#nav"}><Nav /></div>

<h1>Нове замовлення</h1>

<form hx-post="/form" hx-target="#main">
  <Field name="customer" label="Клієнт" value={form.customer} error={errors.customer} />
  <Field name="email" label="Пошта" value={form.email} error={errors.email} />
  <Field name="amount" label="Сума" value={form.amount} error={errors.amount} />
  <button>Створити</button>
</form>

<p @if={saved}>Створено №{{ saved.id }} на {{ money(saved.amount) }}.</p>
