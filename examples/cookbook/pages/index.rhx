---
page.title = "Кухарська книга rhaix";

let recipes = [
    #{ href: "/table",      title: "Таблиця з фільтром і сортуванням",
       task: "Показати список із бази, дати фільтр і сортування — без перезавантаження сторінки." },
    #{ href: "/form",       title: "Форма з валідацією",
       task: "Прийняти дані, показати помилки поруч із полями, зберегти в базу." },
    #{ href: "/modal",      title: "Модальне вікно",
       task: "Відкрити картку в діалозі, не покидаючи сторінку." },
    #{ href: "/search",     title: "Живий пошук",
       task: "Шукати під час набору, не забиваючи сервер запитами." },
    #{ href: "/pagination", title: "Пагінація",
       task: "Гортати сторінками так, щоб посилання лишалось робочим." },
    #{ href: "/upload",     title: "Завантаження файлу",
       task: "Прийняти файл, перевірити розмір і зберегти на диск." },
    #{ href: "/contact",    title: "Форма зворотного зв'язку",
       task: "Перевірити поля й надіслати лист (у dev — у консоль)." },
];
---
<div @if={req.is_htmx} @oob={"#nav"}><Nav /></div>

<h1>Кухарська книга</h1>
<p>Кожен рецепт — одна задача й один готовий файл <code>.rhx</code>.
   Усе працює на тій самій базі: <code>migrations/001_orders.sql</code>.</p>

<div class="recipe" @for={r in recipes}>
  <h2><a href={r.href} hx-get={r.href} hx-target="#main" hx-push-url="true">{{ r.title }}</a></h2>
  <p>{{ r.task }}</p>
</div>
