---
// ЗАДАЧА: гортати сторінками так, щоб посилання лишалось робочим —
// його можна скопіювати, надіслати й відкрити напряму.
// Уся арифметика (межі, skip, вікно номерів) — у `paginate()`.
page.title = "Пагінація";

const PER_PAGE = 2;
let total = db.count("orders");
let p = paginate(total, PER_PAGE, req.query_int("page") ?? 1);

let orders = db.find("orders", #{}, #{ sort: "id asc", limit: PER_PAGE, skip: p.skip });
---
<h1>Пагінація</h1>

<table>
  <thead><tr><th>№</th><th>Клієнт</th><th>Сума</th></tr></thead>
  <tbody>
    <tr @for={o in orders}>
      <td>{{ o.id }}</td>
      <td>{{ o.customer }}</td>
      <td>{{ money(o.amount) }}</td>
    </tr>
  </tbody>
</table>

<p>
  <a @if={p.has_prev} href={url("/pagination", #{ page: p.prev })}
     hx-get={url("/pagination", #{ page: p.prev })} hx-target="#main" hx-push-url="true">‹</a>
  <a @for={n in p.window}
     href={url("/pagination", #{ page: n })}
     hx-get={url("/pagination", #{ page: n })}
     hx-target="#main" hx-push-url="true"
     @class={#{"active": n == p.page}}>{{ n }}</a>
  <a @if={p.has_next} href={url("/pagination", #{ page: p.next })}
     hx-get={url("/pagination", #{ page: p.next })} hx-target="#main" hx-push-url="true">›</a>
</p>
<p>Сторінка {{ p.page }} із {{ p.pages }} — показано {{ p.from }}–{{ p.to }} з {{ p.total }}.</p>
