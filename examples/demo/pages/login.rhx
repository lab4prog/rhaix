---
page.title = "Вхід";
let error = "";

if req.method == "POST" {
    let username = req.form("username").trim();
    let password = req.form("password");
    // Перебір паролів: не більше 5 спроб за 5 хвилин на пару «адреса + ім'я».
    // Успішний вхід рахунок скидає (`state.reset` нижче) — саме тому в ключі
    // є ім'я: вхід у власний акаунт не має обнуляти спроби на чужий.
    let attempts = `login:${req.ip}:${username.to_lower()}`;

    if !state.allow(attempts, 5, 300) {
        error = `Забагато спроб. Спробуйте за ${state.retry_after(attempts)} с`;
        res.status(429);
    } else if is_blank(username) || is_blank(password) {
        error = "Введіть ім'я та пароль";
        res.status(422);
    } else {
        // Демо входу й реєстрації в одному: якщо такого користувача ще немає —
        // створюємо (пароль хешується Argon2); якщо є — перевіряємо пароль.
        let found = db.find("users", #{ username: username }, #{ limit: 1 });

        if found.is_empty() {
            db.insert("users", #{ username: username, password: hash_password(password) });
            session.set("user", username);
            state.reset(attempts);
            hx.toast(`Реєстрація успішна, ${username}!`, "success");
            res.redirect("/admin");
        } else if verify_password(password, found[0].password) {
            session.set("user", username);
            state.reset(attempts);
            hx.toast(`Вітаємо, ${username}!`, "success");
            res.redirect("/admin");
        } else {
            error = "Невірний пароль";
            res.status(422);
        }
    }
}
---
<div @if={req.is_htmx} @oob={"#nav"}><Nav /></div>

<h1>Вхід</h1>
<p>Паролі хешуються <b>Argon2id</b> з випадковою сіллю — не SHA-256.
   У базі лежить рядок формату PHC, а не пароль.</p>
<p>Демо: перший вхід із новим іменем реєструє користувача, наступний —
   перевіряє пароль. Приховане поле CSRF у форму фреймворк додав сам.</p>

<form method="post" action="/login">
  <p><input name="username" placeholder="Ім'я користувача" autofocus></p>
  <p><input name="password" type="password" placeholder="Пароль"></p>
  <button>Увійти або зареєструватися</button>
</form>
<p class="error" @if={error}>{{ error }}</p>
