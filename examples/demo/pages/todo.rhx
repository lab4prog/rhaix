---
page.title = "ToDo";

let error = "";

if req.method == "POST" {
    let title = req.form("title").trim();
    if title == "" {
        error = "Назва не може бути порожньою";
        res.status(422);
    } else {
        db.insert("todos", #{ title: title, done: false });
        hx.toast(`Додано: ${title}`, "success");
    }
}

if req.method == "PATCH" {
    let id = req.query_int("id");
    let todo = db.get("todos", id);
    if todo != () {
        db.update("todos", id, #{ done: !todo.done });
    }
}

if req.method == "DELETE" {
    db.delete("todos", req.query_int("id"));
    hx.toast("Видалено", "info");
}

let todos = db.find("todos", #{}, #{ sort: "done asc, id asc" });
---

<div @if={req.is_htmx} @oob={"#nav"}><Nav /></div>

<div id="todo-app">
  <Ui.Card tone="wide">
    <template slot="header"><h1>ToDo</h1></template>

    <form hx-post="/todo" hx-target="#todo-app" hx-swap="outerHTML"
          hx-on::after-request="this.reset()">
      <input name="title" placeholder="Що зробити?" autocomplete="off"
             @class={#{"invalid": error != ""}}>
      <button>Додати</button>
      <small @if={error} class="err">{{ error }}</small>
    </form>

    <TodoList todos={todos} />

    {{! `#todo-app` цілком заміняється (`hx-swap="outerHTML"`) при кожній
        мутації, тому статистика всередині нього лишається свіжою сама собою —
        без окремого запиту й без @oob: рахувати нема що складніше, ніж
        перерендерити компонент разом із рештою картки. }}
    <Stats />
  </Ui.Card>

  <p class="hint">
    Дані — у SQLite (<code>data/demo.db</code>), схема — у
    <code>migrations/001_todos.sql</code>.
  </p>
</div>
