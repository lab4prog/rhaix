---
page.title = "ToDo";

// До M5 замість БД — процесне сховище. Дані живуть до перезапуску сервера.
if !state.has("todos") {
    state.set("todos", [
        #{ id: 1, title: "Купити молоко", done: true },
        #{ id: 2, title: "Прочитати SYNTAX.md", done: false },
    ]);
    state.set("next_id", 3);
}

let todos = state.get("todos");
let error = "";

if req.method == "POST" {
    let title = req.form("title").trim();
    if title == "" {
        error = "Назва не може бути порожньою";
        res.status(422);
    } else {
        let id = state.get("next_id");
        todos.push(#{ id: id, title: title, done: false });
        state.set("next_id", id + 1);
        state.set("todos", todos);
        hx.toast(`Додано: ${title}`, "success");
        hx.trigger("todoChanged");
    }
}

if req.method == "PATCH" {
    let id = req.query_int("id");
    for i in 0..todos.len() {
        if todos[i].id == id { todos[i].done = !todos[i].done; }
    }
    state.set("todos", todos);
    hx.trigger("todoChanged");
}

if req.method == "DELETE" {
    let id = req.query_int("id");
    todos = todos.filter(|t| t.id != id);
    state.set("todos", todos);
    hx.toast("Видалено", "info");
    hx.trigger("todoChanged");
}
---

<div id="todo-app">
  <Ui.Card tone="wide">
    <template slot="header"><h1>ToDo</h1></template>

    <form hx-post="/todo" hx-target="#todo-app" hx-swap="outerHTML"
          hx-on::after-request="this.reset()">
      <input name="title" placeholder="Що зробити?" autocomplete="off"
             @class={#{"invalid": error != ""}}>
      <button>Додати</button>
      <small @if={error} class="err">{{ error }}</small>
    </form>

    <TodoList todos={todos} />

    {{! фрагмент підтягується сам: спершу на load, далі на кожну подію todoChanged }}
    <div hx-get="/components/stats" hx-trigger="load"></div>
  </Ui.Card>

  {{! Після зміни списку той самий блок статистики оновлюється поза основною
      ціллю — одна відповідь, два оновлені місця (SYNTAX 4.7). }}
  <div @if={req.method != "GET"} @oob={"#stats"} class="stats"
       hx-get="/components/stats" hx-trigger="todoChanged from:body">
    <Stats />
  </div>

  <p class="hint">
    Розмітка списку — у <code>components/TodoList.rhx</code> і
    <code>components/TodoItem.rhx</code>, картка — <code>components/ui/Card.rhx</code>.
  </p>
</div>
