---
page.title = "ToDo";

// До M5 замість БД — процесне сховище. Дані живуть до перезапуску сервера.
if !state.has("todos") {
    state.set("todos", [
        #{ id: 1, title: "Купити молоко", done: true },
        #{ id: 2, title: "Прочитати SYNTAX.md", done: false },
    ]);
    state.set("next_id", 3);
}

let todos = state.get("todos");
let error = "";

if req.method == "POST" {
    let title = req.form("title").trim();
    if title == "" {
        error = "Назва не може бути порожньою";
        res.status(422);
    } else {
        let id = state.get("next_id");
        todos.push(#{ id: id, title: title, done: false });
        state.set("next_id", id + 1);
        state.set("todos", todos);
        hx.toast(`Додано: ${title}`, "success");
    }
}

if req.method == "PATCH" {
    let id = req.query_int("id");
    for i in 0..todos.len() {
        if todos[i].id == id { todos[i].done = !todos[i].done; }
    }
    state.set("todos", todos);
}

if req.method == "DELETE" {
    let id = req.query_int("id");
    todos = todos.filter(|t| t.id != id);
    state.set("todos", todos);
    hx.toast("Видалено", "info");
}

let left = todos.filter(|t| !t.done).len();
---

<div id="todo-app">
  <h1>ToDo</h1>

  <form hx-post="/todo" hx-target="#todo-app" hx-swap="outerHTML"
        hx-on::after-request="this.reset()">
    <input name="title" placeholder="Що зробити?" autocomplete="off"
           @class={#{"invalid": error != ""}}>
    <button>Додати</button>
    <small @if={error} class="err">{{ error }}</small>
  </form>

  <ul class="todo-list">
    <li @for={t in todos} class="todo-item" @class={#{"completed": t.done}}>
      <input type="checkbox" @attr={#{"checked": t.done}}
             hx-patch={url("/todo", #{ id: t.id })}
             hx-target="#todo-app" hx-swap="outerHTML">
      <span>{{ t.title }}</span>
      <button class="del" hx-delete={url("/todo", #{ id: t.id })}
              hx-target="#todo-app" hx-swap="outerHTML">×</button>
    </li>
    <li @if={todos.is_empty()} class="empty">Порожньо</li>
  </ul>

  <p class="hint">
    Лишилось: <b>{{ left }}</b> із {{ todos.len() }}.
    Уся логіка — у frontmatter цього файлу, дані в `state` (до M5 замість БД).
  </p>
</div>
