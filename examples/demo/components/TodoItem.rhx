---
let todo = props.todo;
---
<li class="todo-item" @class={#{"completed": todo.done}}>
  <input type="checkbox" @attr={#{"checked": todo.done}}
         hx-patch={url("/todo", #{ id: todo.id })}
         hx-target="#todo-app" hx-swap="outerHTML">
  <span>{{ todo.title }}</span>
  <button class="del" hx-delete={url("/todo", #{ id: todo.id })}
          hx-target="#todo-app" hx-swap="outerHTML">×</button>
</li>

<style>
  /* Стиль компонента: піднімається в <head> один раз, скільки б разів
     компонент не траплявся у списку. */
  .todo-item .del { border: 0; background: none; cursor: pointer; opacity: .4 }
  .todo-item:hover .del { opacity: 1 }
</style>

<script>
  // Скрипт компонента виконується один раз на життя сторінки — навіть якщо
  // список приїхав фрагментом ще десять разів.
  console.log("rhaix: TodoItem готовий");
</script>
