<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>rhaix — демо</title>
  <rhaix:head />
</head>
<body hx-boost="true">
  <nav>
    <a href="/" hx-get="/" hx-target="#main" hx-push-url="true">Головна</a>
    <a href="/todo" hx-get="/todo" hx-target="#main" hx-push-url="true">ToDo</a>
    <a href="/contacts" hx-get="/contacts" hx-target="#main" hx-push-url="true">Контакти</a>
  </nav>

  <main id="main"><slot /></main>

  <div id="toasts" class="toasts"></div>

  <!-- M7: htmx буде вендоритись у public/vendor/ і підхоплюватись <rhaix:scripts/> -->
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.7/dist/htmx.min.js"></script>
  <rhaix:scripts />
</body>
</html>
